# Copy to .env.production (gitignored) and set your API server address.
# Next.js inlines this value into the static export at build time, so it must
# be reachable from wherever the app runs:
#   - Android emulator:  http://10.0.2.2:3001
#   - Physical phone:    http://<your-machine-LAN-IP>:3001  (phone and machine on same network)
#   - Deployed backend:  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

